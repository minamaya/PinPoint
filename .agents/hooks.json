{
  "pinpoint-session-start": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/session-start.cjs",
        "timeout": 30
      }
    ]
  },
  "pinpoint-pre-invocation": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/pre-invocation.cjs",
        "timeout": 10
      }
    ]
  },
  "pinpoint-pre-tool-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-guard.cjs",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "call_mcp_tool|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-mcp-guard.cjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "pinpoint-post-tool-reminders": {
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/post-tool-reminders.cjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
