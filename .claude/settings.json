{
  "permissions": {
    "allow": [
      "Bash(bash scripts/workflow/approve-ui.sh *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr update-branch *)",
      "Bash(node scripts/workflow/pr-screenshots.mjs *)",
      "Bash(pnpm run dev:stop)",
      "Bash(pnpm run dev:stop --dry-run)"
    ],
    "deny": [
      "Bash(supabase db push:*)",
      "Bash(supabase projects delete:*)",
      "Bash(supabase stop --all)",
      "Bash(supabase stop --all *)",
      "Bash(pkill:*)",
      "Bash(killall:*)",
      "Bash(gh issue delete *)",
      "Bash(gh repo delete *)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(mkfs:*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh pr merge*--admin*)",
      "Bash(gh pr -* merge *--admin*)",
      "Bash(gh pr update-branch *--rebase*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *mergePullRequest*)",
      "Bash(gh api *enablePullRequestAutoMerge*)",
      "Bash(gh api *pending_deployments*)",
      "Bash(gh pr checkout*)",
      "Bash(gh pr co *)",
      "Bash(gh co *)",
      "mcp__*__merge_pull_request",
      "mcp__*__enable_pr_auto_merge"
    ],
    "ask": [
      "Bash(supabase db reset:*)",
      "Bash(supabase db remote commit:*)",
      "Bash(supabase migration repair:*)",
      "Bash(supabase branches delete:*)",
      "mcp__*__execute_sql",
      "mcp__*__apply_migration",
      "mcp__*__deploy_edge_function",
      "mcp__*__pause_project",
      "mcp__*__restore_project",
      "mcp__*__create_project",
      "mcp__*__delete_branch",
      "mcp__*__merge_branch",
      "mcp__*__rebase_branch",
      "mcp__*__reset_branch",
      "mcp__claude_ai_Supabase__create_branch",
      "mcp__Supabase__create_branch",
      "mcp__plugin_supabase_supabase__create_branch",
      "mcp__*-*-*-*-*__create_branch",
      "Bash(rm -rf:*)",
      "Bash(rm -fr *)",
      "Bash(docker rm:*)",
      "Bash(docker volume rm:*)",
      "Bash(kill:*)",
      "Bash(xargs kill:*)",
      "Bash(git rebase *)",
      "Bash(git -C * rebase *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git -C * reset --hard)",
      "Bash(git -C * reset --hard *)",
      "Bash(git clean *)",
      "Bash(git -C * clean *)",
      "Bash(git branch -D *)",
      "Bash(git -C * branch -D *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git -C * push --force)",
      "Bash(git -C * push --force *)",
      "Bash(git -C * push --force-with-lease *)",
      "Bash(git -C * push -f *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/block-main-worktree-branch-switch.cjs",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/preflight-reminder.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ui-screenshot-reminder.cjs",
            "timeout": 5
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/worktree-create.sh",
            "timeout": 240
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/worktree_cleanup.py\" --claude-hook",
            "timeout": 400
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/scripts/hooks/prototype-mode-poll.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/beads-actor-env.cjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/session-start-worktree-reap.sh",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/scripts/hooks/prototype-mode-poll.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/verify-guard-stack.cjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/session-start-chores-nag.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "modern-web-guidance@googlechrome": true
  },
  "extraKnownMarketplaces": {
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      }
    }
  }
}
